# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# dados operacionais reais e backups — nunca versionar dados de producao,
# cadastros de frota ou copias do banco SQLite. O banco oficial vive fora
# do projeto (%LOCALAPPDATA%\SistemaLimpezaFrota), fora do Git de proposito.
/backups/
/data/

# configuracao local/pessoal do Claude Code (permissoes especificas desta
# maquina) — nao e config compartilhada do projeto.
.claude/settings.local.json
