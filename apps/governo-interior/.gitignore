# Este app é independente do sistema de limpeza na raiz do repositório —
# tem seu próprio .gitignore porque um `/node_modules` no .gitignore da raiz
# (com barra inicial) não alcança node_modules aninhado em apps/*.

# dependencies
node_modules

# testing
coverage

# next.js
.next/
out/

# production
build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
